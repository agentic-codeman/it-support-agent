# 数据库配置
# 请替换为你的数据库连接串（root 密码留空，需自行填写）
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/wenda_agent?charset=utf8mb4

# Redis 配置（用于 Token 黑名单、分布式锁等）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0


NO_PROXY=localhost,127.0.0.1

# JWT 配置
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=7


# Embedding 配置（使用 Ollama 本地部署 bge-m3）
EMBEDDING_API_URL=http://127.0.0.1:11434/api/embed
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIMENSION=1024


# Milvus 向量数据库配置
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION_NAME=wendarobot
MILVUS_COLLECTION_DIMENSION=1024
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE

# RestFS 对象存储配置
RESTFS_URL=http://127.0.0.1:9000
RESTFS_ACCESS_KEY_ID=
RESTFS_SECRET_ACCESS_KEY=
RESTFS_REGION=us-east-1
RESTFS_BUCKET=wendarobot
RESTFS_IMG_DIR=upload-images

# LLM 配置（使用阿里云百炼）
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_API_BASE=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
LLM_API_KEY=
RERANK_MODEL=qwen3-rerank
LLM_MODEL=qwen-max
VL_MODEL=qwen3-vl-flash
LLM_TEMPERATURE=0.7
SYSTEM_MODEL=qwen-turbo


# LangSmith 可观测性（可选）
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=wenda-agent


# ===================== 日志配置 =====================
# 控制台日志：True=开启/False=关闭，级别可选(DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO

# 文件日志：True=开启/False=关闭，级别与控制台可独立设置
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=DEBUG
# 日志文件保留天数（自动删除过期日志，避免磁盘占满）
LOG_FILE_RETENTION=7 days

# mineru api 以及 url 处理地址
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net/api/v4
# 解析模型：pipeline（默认，快而稳）| vlm（精度高但慢、易排队）
MINERU_MODEL_VERSION=vlm
